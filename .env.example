# 音声合成。ElevenLabs → OpenAI → macOS の say の順に試される。
# ElevenLabs 無料枠: 月 10,000 文字（本アプリの全12問で約 1,000 文字）
ELEVENLABS_API_KEY=
# OpenAI は前払いクレジット制で、無料枠は無い
OPENAI_API_KEY=

# Cloudflare Web Analytics のサイトトークン（未設定なら計測しない）
# Cloudflare ダッシュボード → Analytics & Logs → Web Analytics → Add a site で発行する
NEXT_PUBLIC_CF_BEACON_TOKEN=
